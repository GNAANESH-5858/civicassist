# Copy to .env for local `netlify dev`. Never commit .env. All values are optional.
# AI (read only by netlify/functions/llm.ts). On Netlify the AI Gateway can inject GEMINI_API_KEY and GOOGLE_GEMINI_BASE_URL.
GEMINI_API_KEY=
GROQ_API_KEY=
# GEMINI_MODEL=
# GROQ_MODEL=
# Enables the admin records view on /officer. At least 32 random characters. Leave empty to disable.
CIVICASSIST_ADMIN_TOKEN=
